{
	"name": "ei-worker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "wrangler deploy --dry-run --outdir dist",
		"check": "biome check .",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "biome format --write .",
		"test": "node --test \"test/*_test.js\"",
		"test_integration": "node --env-file=.env --test integration/api_test.js"
	},
	"dependencies": {
		"google-protobuf": "3.21.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"wrangler": "4.118.0"
	},
	"engines": {
		"node": ">=22"
	}
}
